# Copy this file to .env and fill in real values. Never commit .env.

# Etsy API v3 credentials (https://www.etsy.com/developers/your-apps)
ETSY_API_KEY=
ETSY_API_SECRET=
ETSY_SHOP_ID=

# OAuth redirect URI — must match what's registered in the Etsy developer portal
ETSY_REDIRECT_URI=http://localhost:8000/oauth/callback

# Token storage (file path where OAuth tokens are persisted locally)
ETSY_TOKEN_FILE=.etsy_tokens.json
